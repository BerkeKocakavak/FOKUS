<Window x:Class="FokusKararMotoru.DetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FOKUS Detaylar"
        Width="880"
        Height="620"
        MinWidth="760"
        MinHeight="500"
        Background="#F4F7FB"
        Foreground="{StaticResource TextBrush}">
    <TabControl Margin="16">
        <TabItem Header="Cezalar">
            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>
                <ListBox x:Name="PenaltyList"/>
                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                    <TextBlock Text="Kara Liste" FontWeight="SemiBold"/>
                    <TextBlock x:Name="BlacklistText"
                               Margin="0,8,0,16"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="Yok"/>
                    <TextBlock Text="Hata / Müdahale" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ErrorText"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource DangerBrush}"
                               Text="Yok"/>
                </StackPanel>
            </Grid>
        </TabItem>

        <TabItem Header="Girdi ve Analiz">
            <UniformGrid Columns="3" Margin="12">
                <StackPanel>
                    <TextBlock Text="Bakış yönü" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock x:Name="GazeDirectionText" FontSize="20" FontWeight="SemiBold" Text="-"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Baş durumu" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock x:Name="PostureStatusText" FontSize="20" FontWeight="SemiBold" Text="-"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="EAR" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock x:Name="EarText" FontSize="20" FontWeight="SemiBold" Text="-"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Bakış / Postür" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock x:Name="PoseText" FontSize="20" FontWeight="SemiBold" Text="-"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Kırpma" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock x:Name="BlinkText" FontSize="20" FontWeight="SemiBold" Text="0"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Tuş/dk" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock x:Name="KeysPerMinuteText" FontSize="20" FontWeight="SemiBold" Text="0"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Fare px/dk" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock x:Name="MousePerMinuteText" FontSize="20" FontWeight="SemiBold" Text="0"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Hareketsiz sn" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock x:Name="IdleSecondsText" FontSize="20" FontWeight="SemiBold" Text="0"/>
                </StackPanel>
            </UniformGrid>
        </TabItem>

        <TabItem Header="Oturum">
            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <UniformGrid Columns="2">
                    <StackPanel>
                        <TextBlock Text="Süre" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBlock x:Name="SessionDurationText" FontSize="24" FontWeight="SemiBold" Text="00:00"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Ortalama odak" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBlock x:Name="AverageFocusText" FontSize="24" FontWeight="SemiBold" Text="-"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Minimum odak" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBlock x:Name="MinimumFocusText" FontSize="24" FontWeight="SemiBold" Text="-"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Düşük odak süresi" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBlock x:Name="LowFocusTimeText" FontSize="24" FontWeight="SemiBold" Text="0 sn"/>
                    </StackPanel>
                </UniformGrid>
                <Grid Grid.Column="1" Margin="18,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Yenile" Click="RefreshReportsButton_Click"/>
                        <TextBlock Text="Geçmiş Oturumlar" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ListBox x:Name="SessionHistoryList" Grid.Row="1"/>
                </Grid>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
