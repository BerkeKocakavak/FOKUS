<Window x:Class="FokusKararMotoru.FocusAlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380"
        Height="168"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#FFF7ED"
        Loaded="Window_Loaded">
    <Border BorderBrush="#FDBA74" BorderThickness="1" Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="TitleText"
                       Text="Odak uyarısı"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="#9A3412"/>
            <TextBlock x:Name="MessageText"
                       Grid.Row="1"
                       Margin="0,10,0,8"
                       TextWrapping="Wrap"
                       FontSize="14"
                       Foreground="#7C2D12"/>
            <TextBlock x:Name="NoteText"
                       Grid.Row="2"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="#9A3412"/>
        </Grid>
    </Border>
</Window>
