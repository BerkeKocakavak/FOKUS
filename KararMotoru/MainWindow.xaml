<Window x:Class="FokusKararMotoru.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FOKUS"
        Width="1080"
        Height="700"
        MinWidth="960"
        MinHeight="620"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Background="#F4F7FB"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="StartButton" Content="Başlat" Click="StartButton_Click"/>
                <Button x:Name="StopButton" Content="Durdur" Click="StopButton_Click"/>
                <Button x:Name="DetailsButton" Content="Detaylar" Click="ShowDetailsButton_Click"/>
                <Button x:Name="SettingsButton" Content="Ayarlar" Click="ShowSettingsButton_Click"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="FOKUS" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock x:Name="StatusText"
                           Margin="0,3,0,0"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="Uygulama hazırlanıyor"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <Border BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Background="#111827"
                    CornerRadius="8"
                    ClipToBounds="True">
                <Grid>
                    <Image x:Name="CameraImage" Stretch="Uniform"/>
                    <TextBlock x:Name="CameraPlaceholder"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#CBD5E1"
                               FontSize="18"/>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Margin="16,0,0,0"
                    Padding="18"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Canlı Durum" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="FocusScoreText"
                                   Margin="0,18,0,2"
                                   Text="100"
                                   FontSize="54"
                                   FontWeight="Bold"/>
                        <ProgressBar x:Name="FocusProgress"
                                     Height="12"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="100"
                                     Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock x:Name="LastAlertText"
                                   Margin="0,8,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="Son uyarı yok"/>

                        <UniformGrid Columns="2" Margin="0,22,0,0">
                            <StackPanel Margin="0,0,12,14">
                                <TextBlock Text="Yüz" Foreground="{StaticResource MutedTextBrush}"/>
                                <TextBlock x:Name="FaceStatusText" FontSize="16" FontWeight="SemiBold" Text="Bekleniyor"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="Pipe" Foreground="{StaticResource MutedTextBrush}"/>
                                <TextBlock x:Name="PipeStatusText" FontSize="16" FontWeight="SemiBold" Text="Bekleniyor"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,14">
                                <TextBlock Text="Müdahale" Foreground="{StaticResource MutedTextBrush}"/>
                                <TextBlock x:Name="InterventionStatusText" FontSize="16" FontWeight="SemiBold" Text="Kapalı"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="Ön plan" Foreground="{StaticResource MutedTextBrush}"/>
                                <TextBlock x:Name="ForegroundProcessText" FontSize="16" FontWeight="SemiBold" Text="-"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,14">
                                <TextBlock Text="Analiz" Foreground="{StaticResource MutedTextBrush}"/>
                                <TextBlock x:Name="AnalysisStatusText" FontSize="16" FontWeight="SemiBold" Text="-"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="Kalibrasyon" Foreground="{StaticResource MutedTextBrush}"/>
                                <TextBlock x:Name="CalibrationStatusText" FontSize="16" FontWeight="SemiBold" Text="-"/>
                            </StackPanel>
                        </UniformGrid>

                        <TextBlock Text="Odak Geçmişi" Margin="0,10,0,8" FontWeight="SemiBold"/>
                        <Border Height="130"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Background="#FBFDFF">
                            <Canvas x:Name="HistoryCanvas"/>
                        </Border>

                        <CheckBox x:Name="InterventionToggle"
                                  Margin="0,18,0,0"
                                  Content="Kara liste müdahalesini aç"
                                  Checked="InterventionToggle_Changed"
                                  Unchecked="InterventionToggle_Changed"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
