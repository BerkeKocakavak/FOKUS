<Window x:Class="FokusKararMotoru.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FOKUS"
        Width="1180"
        Height="800"
        MinWidth="980"
        MinHeight="700"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Background="#F4F7FB"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="210"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button x:Name="StartButton" Content="Başlat" Click="StartButton_Click"/>
                <Button x:Name="StopButton" Content="Durdur" Click="StopButton_Click"/>
                <Button x:Name="PauseButton" Content="Ara ver" Click="PauseButton_Click"/>
                <Button x:Name="DashboardButton" Content="İstatistikler" Click="ShowDashboardButton_Click"/>
                <Button x:Name="SettingsButton" Content="Ayarlar" Click="ShowSettingsButton_Click"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="FOKUS" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock x:Name="StatusText"
                           Margin="0,3,0,0"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="Uygulama hazırlanıyor"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <Border BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Background="#111827"
                    CornerRadius="8"
                    ClipToBounds="True">
                <Grid>
                    <Image x:Name="CameraImage" Stretch="Uniform"/>
                    <TextBlock x:Name="CameraPlaceholder"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#CBD5E1"
                               FontSize="18"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1"
                          Margin="16,0,0,0"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Padding="18"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            Background="{StaticResource PanelBrush}"
                            CornerRadius="8">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="Canlı Durum"
                                           FontSize="18"
                                           FontWeight="SemiBold"/>
                                <TextBlock x:Name="InterventionStatusText"
                                           DockPanel.Dock="Right"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="Kapalı"/>
                            </DockPanel>

                            <TextBlock x:Name="FocusScoreText"
                                       Margin="0,14,0,2"
                                       Text="100"
                                       FontSize="56"
                                       FontWeight="Bold"/>
                            <ProgressBar x:Name="FocusProgress"
                                         Height="12"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="100"
                                         Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock x:Name="LastAlertText"
                                       Margin="0,8,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="Son uyarı yok"/>

                            <UniformGrid Columns="2" Margin="0,18,0,0">
                                <StackPanel Margin="0,0,14,12">
                                    <TextBlock Text="Yüz" Foreground="{StaticResource MutedTextBrush}"/>
                                    <TextBlock x:Name="FaceStatusText" FontSize="16" FontWeight="SemiBold" Text="Bekleniyor"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Pipe" Foreground="{StaticResource MutedTextBrush}"/>
                                    <TextBlock x:Name="PipeStatusText" FontSize="16" FontWeight="SemiBold" Text="Bekleniyor"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,14,12">
                                    <TextBlock Text="Ön plan" Foreground="{StaticResource MutedTextBrush}"/>
                                    <TextBlock x:Name="ForegroundProcessText" FontSize="16" FontWeight="SemiBold" Text="-"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Kalibrasyon" Foreground="{StaticResource MutedTextBrush}"/>
                                    <TextBlock x:Name="CalibrationStatusText" FontSize="16" FontWeight="SemiBold" Text="-"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,12,0,0"
                            Padding="16"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            Background="{StaticResource PanelBrush}"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Odak Geçmişi" FontWeight="SemiBold"/>
                            <Border Height="120"
                                    Margin="0,8,0,0"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Background="#FBFDFF">
                                <Canvas x:Name="HistoryCanvas"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <TabControl Grid.Row="2" Margin="0,12,0,0">
            <TabItem Header="Girdi ve Analiz">
                <UniformGrid Columns="4" Margin="12">
                    <StackPanel Margin="0,0,16,12">
                        <TextBlock Text="Bakış yönü" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBlock x:Name="GazeDirectionText" FontSize="18" FontWeight="SemiBold" Text="-"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,12">
                        <TextBlock Text="Baş durumu" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBlock x:Name="PostureStatusText" FontSize="18" FontWeight="SemiBold" Text="-"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,12">
                        <TextBlock Text="EAR" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBlock x:Name="EarText" FontSize="18" FontWeight="SemiBold" Text="-"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Analiz" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBlock x:Name="AnalysisStatusText" FontSize="18" FontWeight="SemiBold" Text="-"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Bakış / Postür" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBlock x:Name="PoseText" FontSize="18" FontWeight="SemiBold" Text="-"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Kırpma" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBlock x:Name="BlinkText" FontSize="18" FontWeight="SemiBold" Text="0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Tuş/dk" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBlock x:Name="KeysPerMinuteText" FontSize="18" FontWeight="SemiBold" Text="0"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Fare px/dk / Hareketsiz" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBlock x:Name="MouseIdleText" FontSize="18" FontWeight="SemiBold" Text="0 / 0 sn"/>
                    </StackPanel>
                </UniformGrid>
            </TabItem>

            <TabItem Header="Cezalar">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>
                    <ListBox x:Name="PenaltyList"/>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <TextBlock Text="Kara Liste" FontWeight="SemiBold"/>
                        <TextBlock x:Name="BlacklistText"
                                   Margin="0,8,0,16"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="Yok"/>
                        <TextBlock Text="Hata / Müdahale" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ErrorText"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource DangerBrush}"
                                   Text="Yok"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Oturum">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>
                    <UniformGrid Columns="4">
                        <StackPanel>
                            <TextBlock Text="Süre" Foreground="{StaticResource MutedTextBrush}"/>
                            <TextBlock x:Name="SessionDurationText" FontSize="22" FontWeight="SemiBold" Text="00:00"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Ortalama odak" Foreground="{StaticResource MutedTextBrush}"/>
                            <TextBlock x:Name="AverageFocusText" FontSize="22" FontWeight="SemiBold" Text="-"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Minimum odak" Foreground="{StaticResource MutedTextBrush}"/>
                            <TextBlock x:Name="MinimumFocusText" FontSize="22" FontWeight="SemiBold" Text="-"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Düşük odak süresi" Foreground="{StaticResource MutedTextBrush}"/>
                            <TextBlock x:Name="LowFocusTimeText" FontSize="22" FontWeight="SemiBold" Text="0 sn"/>
                        </StackPanel>
                    </UniformGrid>
                    <Grid Grid.Column="1" Margin="18,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Yenile" Click="RefreshReportsButton_Click"/>
                            <TextBlock Text="Geçmiş Oturumlar" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ListBox x:Name="SessionHistoryList" Grid.Row="1"/>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
