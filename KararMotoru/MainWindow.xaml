<Window x:Class="FokusKararMotoru.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FOKUS"
        Width="1180"
        Height="760"
        MinWidth="1040"
        MinHeight="660"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Background="#F4F7FB"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="300"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="StartButton" Content="Başlat" Click="StartButton_Click"/>
                <Button x:Name="StopButton" Content="Durdur" Click="StopButton_Click"/>
                <Button x:Name="SaveSettingsButton" Content="Ayarları Kaydet" Click="SaveSettingsButton_Click"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="FOKUS" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock x:Name="StatusText"
                           Margin="0,3,0,0"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="Uygulama hazırlanıyor"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <Border BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Background="#111827"
                    CornerRadius="8"
                    ClipToBounds="True">
                <Grid>
                    <Image x:Name="CameraImage" Stretch="Uniform"/>
                    <TextBlock x:Name="CameraPlaceholder"
                               Text="Kamera görüntüsü bekleniyor"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#CBD5E1"
                               FontSize="18"/>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Margin="16,0,0,0"
                    Padding="18"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Canlı Durum" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="FocusScoreText"
                                   Margin="0,18,0,2"
                                   Text="100"
                                   FontSize="54"
                                   FontWeight="Bold"/>
                        <ProgressBar x:Name="FocusProgress"
                                     Height="12"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="100"
                                     Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock x:Name="LastAlertText"
                                   Margin="0,8,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="Son uyarı yok"/>

                        <UniformGrid Columns="2" Margin="0,22,0,0">
                            <StackPanel Margin="0,0,12,14">
                                <TextBlock Text="Yüz" Foreground="{StaticResource MutedTextBrush}"/>
                                <TextBlock x:Name="FaceStatusText" FontSize="16" FontWeight="SemiBold" Text="Bekleniyor"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="Pipe" Foreground="{StaticResource MutedTextBrush}"/>
                                <TextBlock x:Name="PipeStatusText" FontSize="16" FontWeight="SemiBold" Text="Bekleniyor"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,14">
                                <TextBlock Text="Müdahale" Foreground="{StaticResource MutedTextBrush}"/>
                                <TextBlock x:Name="InterventionStatusText" FontSize="16" FontWeight="SemiBold" Text="Kapalı"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="Ön plan" Foreground="{StaticResource MutedTextBrush}"/>
                                <TextBlock x:Name="ForegroundProcessText" FontSize="16" FontWeight="SemiBold" Text="-"/>
                            </StackPanel>
                        </UniformGrid>

                        <TextBlock Text="Odak Geçmişi" Margin="0,10,0,8" FontWeight="SemiBold"/>
                        <Border Height="112" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Background="#FBFDFF">
                            <Canvas x:Name="HistoryCanvas"/>
                        </Border>

                        <CheckBox x:Name="InterventionToggle"
                                  Margin="0,18,0,0"
                                  Content="Kara liste müdahalesini aç"
                                  Checked="InterventionToggle_Changed"
                                  Unchecked="InterventionToggle_Changed"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TabControl Grid.Row="2" Margin="0,16,0,0">
            <TabItem Header="Cezalar">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>
                    <ListBox x:Name="PenaltyList"/>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <TextBlock Text="Kara Liste" FontWeight="SemiBold"/>
                        <TextBlock x:Name="BlacklistText" Margin="0,8,0,16" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Text="Yok"/>
                        <TextBlock Text="Hata / Müdahale" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ErrorText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" Text="Yok"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Girdi">
                <UniformGrid Columns="5" Margin="12">
                    <StackPanel>
                        <TextBlock Text="Tuş/dk" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBlock x:Name="KeysPerMinuteText" FontSize="22" FontWeight="SemiBold" Text="0"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Fare px/dk" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBlock x:Name="MousePerMinuteText" FontSize="22" FontWeight="SemiBold" Text="0"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Hareketsiz sn" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBlock x:Name="IdleSecondsText" FontSize="22" FontWeight="SemiBold" Text="0"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="EAR" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBlock x:Name="EarText" FontSize="22" FontWeight="SemiBold" Text="-"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Bakış / Postür" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBlock x:Name="PoseText" FontSize="22" FontWeight="SemiBold" Text="-"/>
                    </StackPanel>
                </UniformGrid>
            </TabItem>
            <TabItem Header="Oturum">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>
                    <UniformGrid Columns="2">
                        <StackPanel>
                            <TextBlock Text="Süre" Foreground="{StaticResource MutedTextBrush}"/>
                            <TextBlock x:Name="SessionDurationText" FontSize="24" FontWeight="SemiBold" Text="00:00"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Ortalama odak" Foreground="{StaticResource MutedTextBrush}"/>
                            <TextBlock x:Name="AverageFocusText" FontSize="24" FontWeight="SemiBold" Text="-"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Minimum odak" Foreground="{StaticResource MutedTextBrush}"/>
                            <TextBlock x:Name="MinimumFocusText" FontSize="24" FontWeight="SemiBold" Text="-"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Düşük odak süresi" Foreground="{StaticResource MutedTextBrush}"/>
                            <TextBlock x:Name="LowFocusTimeText" FontSize="24" FontWeight="SemiBold" Text="0 sn"/>
                        </StackPanel>
                    </UniformGrid>
                    <Grid Grid.Column="1" Margin="18,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Yenile" Click="RefreshReportsButton_Click"/>
                            <TextBlock Text="Geçmiş Oturumlar" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ListBox x:Name="SessionHistoryList" Grid.Row="1"/>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Ayarlar">
                <ScrollViewer Margin="12" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Odak eşiği" FontWeight="SemiBold"/>
                            <TextBox x:Name="ThresholdTextBox" Margin="0,8,0,10"/>
                            <TextBlock Text="Önizleme FPS" FontWeight="SemiBold"/>
                            <TextBox x:Name="PreviewFpsTextBox" Margin="0,8,0,10"/>
                            <TextBlock Text="Analiz FPS" FontWeight="SemiBold"/>
                            <TextBox x:Name="AnalysisFpsTextBox" Margin="0,8,0,10"/>
                            <TextBlock Text="Klavye beklenen / dk" FontWeight="SemiBold"/>
                            <TextBox x:Name="KeyboardExpectedTextBox" Margin="0,8,0,10"/>
                            <TextBlock Text="Fare beklenen px / dk" FontWeight="SemiBold"/>
                            <TextBox x:Name="MouseExpectedTextBox" Margin="0,8,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="18,0,0,0">
                            <TextBlock Text="EAR ceza katsayısı" FontWeight="SemiBold"/>
                            <TextBox x:Name="EarPenaltyFactorTextBox" Margin="0,8,0,10"/>
                            <TextBlock Text="EAR ceza tavanı" FontWeight="SemiBold"/>
                            <TextBox x:Name="EarPenaltyCapTextBox" Margin="0,8,0,10"/>
                            <TextBlock Text="Bakış eşiği" FontWeight="SemiBold"/>
                            <TextBox x:Name="GazeThresholdTextBox" Margin="0,8,0,10"/>
                            <TextBlock Text="Bakış ceza katsayısı" FontWeight="SemiBold"/>
                            <TextBox x:Name="GazePenaltyFactorTextBox" Margin="0,8,0,10"/>
                            <TextBlock Text="Postür eşiği" FontWeight="SemiBold"/>
                            <TextBox x:Name="PostureThresholdTextBox" Margin="0,8,0,10"/>
                            <TextBlock Text="Postür ceza katsayısı" FontWeight="SemiBold"/>
                            <TextBox x:Name="PosturePenaltyFactorTextBox" Margin="0,8,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="18,0,0,0">
                            <TextBlock Text="Kara liste" FontWeight="SemiBold"/>
                            <TextBox x:Name="BlacklistSettingsTextBox"
                                     Margin="0,8,0,0"
                                     Height="220"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="18,0,0,0">
                            <TextBlock Text="Beyaz liste" FontWeight="SemiBold"/>
                            <TextBox x:Name="WhitelistSettingsTextBox"
                                     Margin="0,8,0,0"
                                     Height="220"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
