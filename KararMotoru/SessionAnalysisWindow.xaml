<Window x:Class="FokusKararMotoru.SessionAnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Oturum Analizi"
        Width="720"
        Height="560"
        MinWidth="620"
        MinHeight="460"
        Background="#F4F7FB"
        Foreground="{StaticResource TextBrush}">
    <ScrollViewer Margin="18" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="Kapat"
                        Click="CloseButton_Click"/>
                <StackPanel>
                    <TextBlock Text="Oturum Analizi"
                               FontSize="26"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="SummaryText"
                               Margin="0,4,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>

            <UniformGrid Columns="4" Margin="0,18,0,10">
                <Border Margin="0,0,10,0" Padding="12" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Derece" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBlock x:Name="GradeText" FontSize="20" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <Border Margin="0,0,10,0" Padding="12" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Ortalama" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBlock x:Name="AverageText" FontSize="20" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <Border Margin="0,0,10,0" Padding="12" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Düşük odak" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBlock x:Name="LowFocusText" FontSize="20" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <Border Padding="12" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Süre" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBlock x:Name="DurationText" FontSize="20" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Margin="0,8,0,0" Padding="14" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Bulgular" FontWeight="SemiBold"/>
                    <ItemsControl x:Name="FindingsList" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Margin="0,12,0,0" Padding="14" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Sonraki Oturum İçin Öneriler" FontWeight="SemiBold"/>
                    <ItemsControl x:Name="RecommendationsList" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Margin="0,12,0,0" Padding="14" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Ceza ve Kara Liste Özeti" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PenaltyText" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock x:Name="BlacklistText" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
