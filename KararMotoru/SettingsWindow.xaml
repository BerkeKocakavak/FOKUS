<Window x:Class="FokusKararMotoru.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FOKUS Ayarlar"
        Width="940"
        Height="640"
        MinWidth="800"
        MinHeight="540"
        Background="#F4F7FB"
        Foreground="{StaticResource TextBrush}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0"
                       Foreground="{StaticResource MutedTextBrush}"/>
            <Button Content="Kaydet" Click="SaveButton_Click"/>
            <Button Content="Kapat" Click="CloseButton_Click"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <Border Padding="12"
                            Margin="0,0,0,14"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            Background="#FBFDFF"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Kara liste müdahalesi"
                                       FontWeight="SemiBold"/>
                            <CheckBox x:Name="InterventionEnabledCheckBox"
                                      Margin="0,10,0,0"
                                      Content="Kara listedeki uygulamalara müdahale et"/>
                            <TextBlock Text="Kapalıyken uygulamalar yalnızca raporlanır."
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedTextBrush}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Odak eşiği" FontWeight="SemiBold"/>
                    <TextBox x:Name="ThresholdTextBox" Margin="0,8,0,10"/>
                    <TextBlock Text="Önizleme FPS" FontWeight="SemiBold"/>
                    <TextBox x:Name="PreviewFpsTextBox" Margin="0,8,0,10"/>
                    <TextBlock Text="Analiz FPS" FontWeight="SemiBold"/>
                    <TextBox x:Name="AnalysisFpsTextBox" Margin="0,8,0,10"/>
                    <TextBlock Text="Beklenen tuş/dk" FontWeight="SemiBold"/>
                    <TextBox x:Name="KeyboardExpectedTextBox" Margin="0,8,0,10"/>
                    <TextBlock Text="Beklenen fare px/dk" FontWeight="SemiBold"/>
                    <TextBox x:Name="MouseExpectedTextBox" Margin="0,8,0,10"/>
                    <TextBlock Text="Uyarı notu" FontWeight="SemiBold"/>
                    <TextBox x:Name="AlertNoteTextBox"
                             Margin="0,8,0,0"
                             Height="88"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="18,0,0,0">
                    <TextBlock Text="EAR ceza katsayısı" FontWeight="SemiBold"/>
                    <TextBox x:Name="EarPenaltyFactorTextBox" Margin="0,8,0,10"/>
                    <TextBlock Text="EAR ceza tavanı" FontWeight="SemiBold"/>
                    <TextBox x:Name="EarPenaltyCapTextBox" Margin="0,8,0,10"/>
                    <TextBlock Text="Bakış eşiği" FontWeight="SemiBold"/>
                    <TextBox x:Name="GazeThresholdTextBox" Margin="0,8,0,10"/>
                    <TextBlock Text="Bakış ceza katsayısı" FontWeight="SemiBold"/>
                    <TextBox x:Name="GazePenaltyFactorTextBox" Margin="0,8,0,10"/>
                    <TextBlock Text="Postür eşiği" FontWeight="SemiBold"/>
                    <TextBox x:Name="PostureThresholdTextBox" Margin="0,8,0,10"/>
                    <TextBlock Text="Postür ceza katsayısı" FontWeight="SemiBold"/>
                    <TextBox x:Name="PosturePenaltyFactorTextBox" Margin="0,8,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="18,0,0,0">
                    <TextBlock Text="Kara liste" FontWeight="SemiBold"/>
                    <TextBox x:Name="BlacklistSettingsTextBox"
                             Margin="0,8,0,0"
                             Height="350"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="18,0,0,0">
                    <TextBlock Text="Beyaz liste" FontWeight="SemiBold"/>
                    <TextBox x:Name="WhitelistSettingsTextBox"
                             Margin="0,8,0,0"
                             Height="350"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
