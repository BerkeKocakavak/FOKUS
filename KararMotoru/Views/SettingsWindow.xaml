<Window x:Class="FokusKararMotoru.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FOKUS Ayarlar"
        Width="980"
        Height="720"
        MinWidth="860"
        MinHeight="620"
        Background="#F4F7FB"
        Foreground="{StaticResource TextBrush}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0"
                       Foreground="{StaticResource MutedTextBrush}"/>
            <Button Content="Kaydet" Click="SaveButton_Click"/>
            <Button Content="Kapat" Click="CloseButton_Click"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <DockPanel Margin="0,0,0,14" LastChildFill="False">
                    <StackPanel>
                        <TextBlock Text="Ayarlar"
                                   FontSize="22"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                    <Button x:Name="AdvancedToggleButton"
                            DockPanel.Dock="Right"
                            Content="Gelişmiş ayarları göster"
                            Click="AdvancedToggleButton_Click"/>
                </DockPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*"/>
                        <ColumnDefinition Width="1.35*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <Border Padding="14"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                Background="#FBFDFF"
                                CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="Temel takip"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="Odak eşiği"
                                           Margin="0,14,0,0"
                                           FontWeight="SemiBold"/>
                                <TextBox x:Name="ThresholdTextBox" Margin="0,8,0,10"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Önizleme FPS" FontWeight="SemiBold"/>
                                        <TextBox x:Name="PreviewFpsTextBox" Margin="0,8,0,10"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="Analiz FPS" FontWeight="SemiBold"/>
                                        <TextBox x:Name="AnalysisFpsTextBox" Margin="0,8,0,10"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Boş bakış süresi sn" FontWeight="SemiBold"/>
                                <TextBox x:Name="BlankGazeSecondsTextBox" Margin="0,8,0,10"/>

                                <TextBlock Text="Uyarı notu" FontWeight="SemiBold"/>
                                <TextBox x:Name="AlertNoteTextBox"
                                         Margin="0,8,0,0"
                                         Height="96"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Border>

                        <Border Padding="14"
                                Margin="0,14,0,0"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                Background="#FBFDFF"
                                CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="Kara liste müdahalesi"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>
                                <CheckBox x:Name="InterventionEnabledCheckBox"
                                          Margin="0,12,0,0"
                                          Content="Kara listedeki uygulamalara müdahale et"/>
                                <TextBlock Text="Kapalıyken uygulamalar yalnızca raporlanır."
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Grid Grid.Column="1" Margin="18,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,9,0">
                            <TextBlock Text="Kara liste" FontWeight="SemiBold"/>
                            <TextBox x:Name="BlacklistSettingsTextBox"
                                     Margin="0,8,0,0"
                                     Height="360"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="9,0,0,0">
                            <TextBlock Text="Beyaz liste" FontWeight="SemiBold"/>
                            <TextBox x:Name="WhitelistSettingsTextBox"
                                     Margin="0,8,0,0"
                                     Height="360"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <Border x:Name="AdvancedSettingsPanel"
                        Visibility="Collapsed"
                        Margin="0,18,0,0"
                        Padding="14"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        Background="#FBFDFF"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Gelişmiş ayarlar"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Karar motoru" FontWeight="SemiBold"/>

                                <TextBlock Text="EMA yumuşatma" Margin="0,12,0,0"/>
                                <TextBox x:Name="EmaAlphaTextBox" Margin="0,6,0,10"/>

                                <TextBlock Text="Yüz yokken düşme hızı"/>
                                <TextBox x:Name="FaceMissingDropTextBox" Margin="0,6,0,10"/>

                                <TextBlock Text="Pipe zaman aşımı ms"/>
                                <TextBox x:Name="PipeTimeoutTextBox" Margin="0,6,0,10"/>

                                <TextBlock Text="Girdi örnekleme ms"/>
                                <TextBox x:Name="InputSampleMsTextBox" Margin="0,6,0,10"/>

                                <TextBlock Text="Aktivite penceresi sn"/>
                                <TextBox x:Name="ActivityWindowTextBox" Margin="0,6,0,10"/>

                                <TextBlock Text="Hareketsizlik uyarı sn"/>
                                <TextBox x:Name="IdleWarningTextBox" Margin="0,6,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="12,0,12,0">
                                <TextBlock Text="Girdi ve boş bakış" FontWeight="SemiBold"/>

                                <TextBlock Text="Boş bakış ceza puanı" Margin="0,12,0,0"/>
                                <TextBox x:Name="BlankGazePenaltyTextBox" Margin="0,6,0,10"/>

                                <TextBlock Text="Beklenen tuş/dk"/>
                                <TextBox x:Name="KeyboardExpectedTextBox" Margin="0,6,0,10"/>

                                <TextBlock Text="Beklenen fare px/dk"/>
                                <TextBox x:Name="MouseExpectedTextBox" Margin="0,6,0,10"/>

                                <TextBlock Text="Düşük aktivite ceza tavanı"/>
                                <TextBox x:Name="LowActivityPenaltyCapTextBox" Margin="0,6,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                <TextBlock Text="Biyometrik cezalar" FontWeight="SemiBold"/>

                                <TextBlock Text="EAR ceza katsayısı" Margin="0,12,0,0"/>
                                <TextBox x:Name="EarPenaltyFactorTextBox" Margin="0,6,0,10"/>

                                <TextBlock Text="EAR ceza tavanı"/>
                                <TextBox x:Name="EarPenaltyCapTextBox" Margin="0,6,0,10"/>

                                <TextBlock Text="Bakış eşiği"/>
                                <TextBox x:Name="GazeThresholdTextBox" Margin="0,6,0,10"/>

                                <TextBlock Text="Bakış ceza katsayısı"/>
                                <TextBox x:Name="GazePenaltyFactorTextBox" Margin="0,6,0,10"/>

                                <TextBlock Text="Bakış ceza tavanı"/>
                                <TextBox x:Name="GazePenaltyCapTextBox" Margin="0,6,0,10"/>

                                <TextBlock Text="Postür eşiği"/>
                                <TextBox x:Name="PostureThresholdTextBox" Margin="0,6,0,10"/>

                                <TextBlock Text="Postür ceza katsayısı"/>
                                <TextBox x:Name="PosturePenaltyFactorTextBox" Margin="0,6,0,10"/>

                                <TextBlock Text="Postür ceza tavanı"/>
                                <TextBox x:Name="PosturePenaltyCapTextBox" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
