<Window x:Class="FokusKararMotoru.WorkCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420"
        Height="210"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#EFF6FF"
        Loaded="Window_Loaded">
    <Border BorderBrush="#60A5FA" BorderThickness="1" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Çalışıyor musun?"
                       FontSize="23"
                       FontWeight="SemiBold"
                       Foreground="#1D4ED8"/>
            <TextBlock Grid.Row="1"
                       Margin="0,12,0,16"
                       Text="4 dakikadır klavye veya fare girdisi alınmadı. Takibe devam edilsin mi?"
                       TextWrapping="Wrap"
                       FontSize="14"
                       Foreground="#1E3A8A"/>
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Hayır"
                        Width="92"
                        Margin="0,0,10,0"
                        Padding="10,6"
                        Click="NoButton_Click"/>
                <Button Content="Evet"
                        Width="92"
                        Padding="10,6"
                        FontWeight="SemiBold"
                        Click="YesButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
